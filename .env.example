# AniLedger Environment Variables
# Copy this file to .env and fill in your actual values
# The .env file is gitignored and will not be committed

# AniList OAuth Client ID
# Get yours from: https://anilist.co/settings/developer
# Set the client's redirect URI to: aniledger://auth-callback
# AniLedger uses AniList's implicit grant, so no client secret is needed.
ANILIST_CLIENT_ID=YOUR_CLIENT_ID_HERE
